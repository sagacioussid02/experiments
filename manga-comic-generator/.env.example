ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# mock = free placeholder panels; openai = gpt-image (uses character reference photos); stability = Stability AI
IMAGE_BACKEND=mock
STABILITY_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

DATA_DIR=data/projects

# gpt-image quality: low | medium | high | auto (cost per panel rises steeply with quality)
OPENAI_IMAGE_QUALITY=medium
# Image generation stops once a comic's estimated spend reaches this (USD)
MAX_COMIC_COST_USD=5.0

# Independent vision judge that checks panels against the character sheets (OpenAI model)
# Panel reviews (many calls): gpt-5-mini low matched or beat gpt-5 on our labelled set at ~1/4 the cost
JUDGE_MODEL=gpt-5-mini
# Sheet/marker reviews (few, high stakes) keep the stronger model
SHEET_JUDGE_MODEL=gpt-5
JUDGE_REASONING_EFFORT=low

# The main character's design bible must be approved before script/sheets/panels run
REQUIRE_BIBLE_APPROVAL=true

# Main character: how many alternative sheets to draw for you to pick from (supporting characters get 1)
SHEET_CANDIDATES=3
REQUIRE_SHEET_APPROVAL=true
# Judge every panel and redraw failures with the judge's reasons (up to QA_MAX_RETRIES extra tries)
PANEL_QA=true
QA_MAX_RETRIES=2

# Circuit breaker: after this many judged panels, if fewer than this share pass on the first draw, stop retrying
# (finish the episode with the best attempts, flag them) instead of multiplying cost
QA_BREAKER_MIN_PANELS=4
QA_BREAKER_PASS_RATE=0.5
